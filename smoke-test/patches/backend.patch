         },
     }),
     app.conf.task_queues += (Queue('stop_limits'),)
+
+# Patch (smoke test): these hourly beat tasks call TRON *mainnet* (TronGrid) even when TRON is disabled
+# via COMMON_TASKS_TRON=False. Only schedule them when TRON is enabled.
+if not env('COMMON_TASKS_TRON', default=True, cast=bool):
+    for _task in ('cryptocoins.tasks.trx.get_trc20_unit_price', 'cryptocoins.tasks.trx.retry_unknown_withdrawals'):
+        app.conf.beat_schedule.pop(_task, None)
